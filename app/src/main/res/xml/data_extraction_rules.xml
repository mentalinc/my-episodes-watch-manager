<?xml version="1.0" encoding="utf-8"?>
<!--
    Credentials are sealed with an Android Keystore key and must never leave the device.
    Cloud backup is already disabled via android:allowBackup="false"; these rules also keep
    the encrypted credential file out of device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
