<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/show_management_portal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/manageShows"
        app:titleTextColor="@color/on_text_white"
        app:menu="@menu/home_menu"
        android:background="@color/primaryColor"
        android:textColor="@color/on_text_white"
        style="@style/Widget.MaterialComponents.Toolbar.Primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"

        android:orientation="horizontal">


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectionPanelFavoShows"
            style="@style/HomeButton"
            android:drawableTop="@drawable/outline_favorite_white_48"
            android:background="@null"


            android:text="@string/favouriteShows" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectionPanelIgnoredShows"
            style="@style/HomeButton"
            android:drawableTop="@drawable/outline_block_white_48"
            android:text="@string/ignoredShows" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectionPanelAddShows"
            style="@style/HomeButton"
            android:drawableTop="@drawable/outline_add_circle_outline_white_48"
            android:text="@string/addShow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectionPanelShowsRuntime"
            style="@style/HomeButton"
            android:drawableTop="@drawable/outline_schedule_white_48"
            android:text="@string/ShowRuntime" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addNullRuntime"
            style="@style/HomeButton"
            android:drawableTop="@drawable/outline_schedule_white_48"
            android:text="Null Runtime Correction" />

    </LinearLayout>

</LinearLayout>
