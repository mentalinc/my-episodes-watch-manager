<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        app:title="@string/details"
        app:titleTextColor="@color/on_text_white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryColor"
        android:textColor="@color/on_text_white"
        app:menu="@menu/episode_details_menu"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        />

    <ScrollView
        android:id="@+id/ScrollView01"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <LinearLayout
            android:id="@+id/LinearLayout03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/episodeDetShowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/large_padding"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/large_padding"
                android:paddingTop="10dp"
                android:textStyle="bold"
                tools:text="Runtime - Series Name"/>

            <TextView
                android:id="@+id/episodeDetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/large_padding"
                android:layout_marginTop="6dp"
                android:layout_marginRight="@dimen/large_padding"
                tools:text="Episode Title Of Episode"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerEpisodeImage"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:focusable="true"
                android:nextFocusUp="@+id/textViewEpisodeReleaseTime"
                android:nextFocusDown="@+id/buttonEpisodeWatched"
                tools:ignore="Overdraw">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayoutEpisodeImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:id="@+id/episodeImage"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="w,16:9"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/CoverArtFromShow"
                        android:gravity="center"
                        android:scaleType="centerCrop" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="15dp">

                <TextView
                    android:id="@+id/episodeDetSeasonLabel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/episodeDetailsSeasonLabel" />

                <TextView
                    android:id="@+id/episodeDetSeason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/episodeDetEpisodeLabel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/episodeDetailsEpisodeLabel" />

                <TextView
                    android:id="@+id/episodeDetEpisode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/episodeDetAirdateLabel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/episodeDetailsAirDateLabel" />

                <TextView
                    android:id="@+id/episodeDetAirdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/episodeRuntimeLabel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/episodeRuntimeLabel" />

                <TextView
                    android:id="@+id/episodeRuntime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMazeWebsite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp" />

            <TextView
                android:id="@+id/tvMazeEpisodeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markAsAcquiredButton"
                style="@style/EpisodeDetailButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".025"
                android:text="@string/menuEpisodeMarkAcquired"
                app:icon="@drawable/outline_upcoming_white_48" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markAsSeenButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".025"
                app:icon="@drawable/outline_done_white_48"
                style="@style/EpisodeDetailButton"
                android:text="@string/menuEpisodeMarkWatched" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/colorPrimary" />

            <TextView
                android:id="@+id/ShowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="5dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMazeShowWebsite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp" />

            <TextView
                android:id="@+id/officialShowWebsite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp" />

            <TextView
                android:id="@+id/tvMazeShowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerImage"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:focusable="true"
                android:nextFocusUp="@+id/textViewEpisodeReleaseTime"
                android:nextFocusDown="@+id/buttonEpisodeWatched"
                tools:ignore="Overdraw">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayoutShowImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/showImage"
                    android:layout_width="210dp"
                    android:layout_height="295dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="w,16:9"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/CoverArtFromShow"
                    android:gravity="center"
                    android:scaleType="centerCrop" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </ScrollView>
</LinearLayout>