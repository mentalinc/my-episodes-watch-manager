<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clipToPadding="false"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="@dimen/show_poster_width_default"
        android:layout_height="@dimen/show_poster_height_default"
        android:layout_marginStart="@dimen/grid_leftright_padding"
        android:layout_marginTop="@dimen/grid_topbottom_padding"
        android:layout_marginBottom="@dimen/grid_topbottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/showDetailposter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            tools:src="?attr/sgColorShadow" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">



        <TextView
            android:id="@+id/ShowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:paddingTop="5dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="TESTING IF THIS SHOWS UP"
            tools:text="Show Name" />



        <TextView
            android:id="@+id/showDetailRuntime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:paddingBottom="5dp"
            tools:text="60 mins" />

        <TextView
            android:id="@+id/tvMazeShowDetailSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:paddingBottom="5dp"
            tools:text="Show summary" />

        <TextView
            android:id="@+id/tvMazeShowWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:paddingBottom="5dp"
            tools:text="https://tvmaze.com/shows/...." />

        <TextView
            android:id="@+id/officialShowDetailWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:paddingBottom="5dp"
            tools:text="https://hbo.com./" />



    </LinearLayout>
</LinearLayout>