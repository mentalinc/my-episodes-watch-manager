<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.ShowHomeTabActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutShowHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeDayNight.AppBarOverlay">

        <com.google.android.material.appbar.MaterialToolbar

            android:id="@+id/toolbarShowHome"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primaryColor"
            android:textAppearance="?attr/sgTextColorSecondaryDim"
            app:popupTheme="@style/ThemeDayNight.PopupOverlay"
            app:menu="@menu/home_menu"/>

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbarShowHomeCollapsing"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <com.google.android.material.appbar.MaterialToolbar

                android:id="@+id/toolbarShowHomeTabs"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primaryColor"
                android:textAppearance="?attr/sgTextColorSecondaryDim"
                app:popupTheme="@style/ThemeDayNight.PopupOverlay">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutShowHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/sgTextColorSecondaryDim"
                android:textColor="@color/on_text_white"
                app:tabMode="fixed"
                app:tabMaxWidth="0dp"
                android:background="@color/primaryColor">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Overview" />

        <!---    <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episode Summary" />
-->
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes to Watch" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes to Acquire" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes Coming" />

            </com.google.android.material.tabs.TabLayout>

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/showHomeViewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:textColor="@color/on_text_white"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewListItemsEps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:textColor="@color/on_text_white"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_episode" />


</LinearLayout>