<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme is the default theme. -->

    <style name="ThemeDayNight" parent="Theme.Material3.DayNight.NoActionBar" >
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

    </style>

    <style name="ThemeLight" parent="Theme.Material3.Light.NoActionBar" >
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/on_text_black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>


    </style>

    <style name="ThemeDark" parent="Theme.Material3.Dark.NoActionBar" >
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:textColorPrimary">@color/on_text_white</item>
        <item name="android:textColorSecondary">@color/on_text_white</item>
        <item name="android:textColor">@color/on_text_white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>


    <!-- Text styles -->

    <style name="TextAppearance.SeriesGuide.Body2" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.SeriesGuide.Body2.Bold">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SeriesGuide.Caption" parent="TextAppearance.Material3.BodySmall" />


    <style name="HomeButton" style="?android:attr/materialButtonOutlinedStyle" parent="android:Widget.Material.Button">
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="rippleColor">@color/colorPrimary </item>
        <item name="android:textColor">@color/on_text_white</item>
        <item name="backgroundTint">@color/colorPrimary </item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>


    <style name="EpisodeDetailButton" style="?android:attr/materialButtonOutlinedStyle" parent="android:Widget.Material.Button">
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">25dp</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="rippleColor">@color/colorPrimary </item>
        <item name="android:textColor">@color/on_text_white</item>
        <item name="backgroundTint">@color/colorPrimary </item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="TitleBarSeparator" style="?attr/materialDividerStyle">
        <item name="android:layout_width">1px</item>
        <item name="android:layout_height">match_parent</item>
    </style>

</resources>
